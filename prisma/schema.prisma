// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PubgApi {
  id          Int      @id @default(autoincrement())
  apiKey      String   @map("api_key")
  dataSource  String   @map("data_source")
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@map("pubg_api")
}

model Player {
  id       String  @id @map("player_id")
  name     String  @map("player_name")
  teamName String? @map("team_name")
  region   String

  stats PlayerStat[]

  @@map("players")
}

model Team {
  id            String   @id @map("team_id")
  name          String   @map("team_name")
  formationDate DateTime @map("formation_date")

  @@map("teams")
}

model Match {
  id       String   @id @map("match_id")
  date     DateTime @map("match_date")
  gameMode String   @map("game_mode")
  mapName  String   @map("map_name")

  stats PlayerStat[]

  @@map("matches")
}

model PlayerStat {
  id         Int    @id @default(autoincrement()) @map("stat_id")
  playerId   String @map("player_id")
  matchId    String @map("match_id")
  kills      Int
  deaths     Int
  damage     Int
  rankPoints Int    @map("rank_points")

  player Player @relation(fields: [playerId], references: [id])
  match  Match  @relation(fields: [matchId], references: [id])

  @@map("player_stats")
}

model ContactRequest {
  id Int @id @default(autoincrement()) @map("request_id")

  // Basic contact info
  clientName  String  @map("client_name") // brand or company name
  clientEmail String  @map("client_email")
  message     String? @db.Text // optional extra notes from client

  // Advertising–specific fields
  package            String?   @map("package") // e.g. "1-week", "2-weeks", "1-month"
  paymentMethod      String?   @map("payment_method") // e.g. "eSewa", "Khalti", "Bank"
  transactionId      String?   @map("transaction_id") // payment reference from client
  targetUrl          String?   @map("target_url") // sponsor link to open on banner click
  preferredStartDate DateTime? @map("preferred_start_date")

  // Status & timestamps
  requestDate DateTime @default(now()) @map("request_date") // when the request was created
  status      String   @default("pending") // "pending" | "verified" | "rejected"
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contact_requests")
}

model Banner {
  id          Int      @id @default(autoincrement()) @map("banner_id")
  title       String   @map("banner_title")
  imageUrl    String   @map("banner_image")
  redirectUrl String   @map("redirect_url")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  clicks      Int      @default(0)

  @@map("banners")
}

model PlayerCacheMeta {
  id            Int      @id @default(autoincrement())
  playerName    String
  shard         String   @default("steam")
  lastFetchedAt DateTime @default(now())

  @@unique([playerName, shard])
  @@map("player_cache_meta")
}

model PlayerMatchCache {
  id         Int      @id @default(autoincrement())
  playerName String
  shard      String   @default("steam")
  matchId    String
  data       Json // raw match JSON from PUBG API
  createdAt  DateTime @default(now())

  @@unique([playerName, shard, matchId])
  @@index([playerName, shard, createdAt])
  @@map("player_match_cache")
}
